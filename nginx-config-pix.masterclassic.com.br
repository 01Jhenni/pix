# Configuração Nginx para pix.masterclassic.com.br
# Salve este arquivo em: /etc/nginx/sites-available/pix.masterclassic.com.br

# Redirecionar HTTP para HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name pix.masterclassic.com.br;
    
    # Redirecionar tudo para HTTPS
    return 301 https://$server_name$request_uri;
}

# Configuração HTTPS
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name pix.masterclassic.com.br;

    # Certificados SSL (Terminus geralmente gerencia isso automaticamente)
    # Se o Terminus não gerenciar, descomente e configure:
    # ssl_certificate /etc/ssl/certs/pix.masterclassic.com.br.crt;
    # ssl_certificate_key /etc/ssl/private/pix.masterclassic.com.br.key;
    
    # Configurações SSL recomendadas
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Logs
    access_log /var/log/nginx/pix.masterclassic.com.br.access.log;
    error_log /var/log/nginx/pix.masterclassic.com.br.error.log;

    # Tamanho máximo de upload
    client_max_body_size 10M;

    # Proxy para o servidor Node.js na porta 3000
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        
        # Headers importantes
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # Cache
        proxy_cache_bypass $http_upgrade;
        
        # Buffering
        proxy_buffering off;
    }

    # Health check direto (opcional)
    location /health {
        proxy_pass http://127.0.0.1:3000/health;
        access_log off;
    }
}

