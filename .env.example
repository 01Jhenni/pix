# Configuração do Supabase
SUPABASE_URL=https://joksegwuxhqgoigvhebb.supabase.co
SUPABASE_KEY=sb_publishable_PYm4oqLlgttAQAFmo10dVQ_o6FIW96r

# JWT Secret (altere em produção!)
JWT_SECRET=sua-chave-secreta-super-segura-aqui-mude-em-producao

# Porta do servidor
PORT=3000

# Credenciais BB — Jornada 3 Produção (igual ao n8n)
# Use no servidor para: node scripts/set-pix-credentials.js
# Produção (default): oauth.bb.com.br + api-pix.bb.com.br
# BasicToken = BASIC_AUTH_BASE64 do portal BB (client_id:client_secret em Base64)
# APIKey = GW_APP_KEY (appKey) do portal BB
# BasicToken=<seu_base64>
# APIKey=<seu_gw_app_key>

# Homologação (opcional): descomente e use BB_OAUTH_URL + BB_BASE_URL
# BB_OAUTH_URL=https://oauth.hm.bb.com.br/oauth/token
# BB_BASE_URL=https://api.hm.bb.com.br/pix/v2

# Token OAuth manual (evita 429: use quando o servidor estiver bloqueado pelo Cloudflare)
# Obtenha com npm run test:oauth (quando funcionar) ou do n8n; o app não chama oauth/token enquanto estiver definido
# BB_OAUTH_TOKEN=<token_access_do_BB>
